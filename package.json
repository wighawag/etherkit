{
	"name": "etherkit-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"devDependencies": {
		"@changesets/cli": "^2.29.8"
	},
	"scripts": {
		"prepublishOnly": "pnpm format:check && pnpm build && pnpm check:type-deps",
		"release": "pnpm prepublishOnly && git push --all && pnpm changeset publish && git push --tags",
		"release:ci": "pnpm prepublishOnly && pnpm changeset publish",
		"check:type-deps": "node scripts/check-type-deps.mjs packages/*",
		"format": "pnpm run -r format",
		"format:check": "pnpm run -r format:check",
		"build": "pnpm run -r build",
		"typecheck": "pnpm run -r typecheck",
		"test": "pnpm run -r test"
	}
}
